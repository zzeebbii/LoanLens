{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // `react-perf` is deliberately absent. Its rules flag every inline handler and object
  // literal passed as a prop, which is ordinary idiomatic React — the advice only pays off
  // for memoized children, and this app memoizes nothing. Enabling it produced ~30 warnings
  // whose only remedy was wrapping every callback in `useCallback` to satisfy a linter,
  // which makes the code worse rather than faster.
  "plugins": ["react", "typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    // `x == null` is the one place loose equality is the clearest thing to write: it means
    // "null or undefined", which is exactly the check needed against the `T | null |
    // undefined` shapes query hooks produce. Everything else must be strict.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "unicorn/prefer-node-protocol": "error",
    "import/no-cycle": "error",

    // Vite/React 19 use the automatic JSX runtime; React is never in scope.
    "react/react-in-jsx-scope": "off",
    // Column definitions and chart frames take render callbacks — `cell: (row) => <JSX/>`
    // — which the rule cannot tell apart from a component defined during render. These are
    // invoked as functions and never mounted, so the remount hazard the rule guards against
    // does not exist. Components defined in a component *body* are still flagged.
    "react/no-unstable-nested-components": ["error", { "allowAsProps": true }],
    // Side-effect imports are how stylesheets, and test-environment shims, are pulled in.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "fake-indexeddb/auto"] }]
  },
  "overrides": [
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "scripts/**/*.mjs"],
      "rules": {
        "no-console": "off",
        // Tests index into fixtures and result arrays constantly; an assertion there
        // fails the test loudly, which is exactly what a test should do.
        "typescript/no-non-null-assertion": "off",
        // Helpers scoped to a `describe` block read better next to the cases that use
        // them than hoisted to module scope.
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["src/i18n/config.ts", "src/app/testing/renderApp.tsx"],
      "rules": {
        // i18next's default export *is* the singleton instance, and `.use()` on it is the
        // documented way to attach a plugin. The rule cannot tell that apart from a
        // mistakenly-defaulted named import.
        "import/no-named-as-default-member": "off"
      }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        // These scripts walk trees and read files in deliberate sequence; the
        // parallelism this rule asks for would buy nothing and read worse.
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "node_modules", "src/components/ui"]
}
